{
  "camera": {
    "type": "picamera2",
    "preview_fps": 10,
    "preview_quality": 75
  },
  "capture": {
    "mode": "interval",
    "interval_seconds": 10,
    "daily_times": [],
    "timezone": "Asia/Seoul",
    "params": {}
  },
  "image": {
    "format": "jpeg",
    "quality": 90,
    "embed_metadata": true
  },
  "storages": [
    {
      "type": "file",
      "name": "local",
      "directory": "./captures",
      "layout": "daily"
    },
    {
      "type": "sftp",
      "name": "archive",
      "host": "storage.example.local",
      "port": 22,
      "username": "capture-node",
      "remote_directory": "/captures",
      "password_env": "CAPTURE_NODE_SFTP_PASSWORD",
      "known_hosts": "~/.ssh/known_hosts",
      "connect_timeout_seconds": 10,
      "operation_timeout_seconds": 30,
      "layout": "daily"
    }
  ]
}
