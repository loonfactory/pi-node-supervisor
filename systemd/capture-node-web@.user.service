[Unit]
Description=CaptureNode Web camera instance %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/capture-node
EnvironmentFile=-%h/capture-node/.env.local
EnvironmentFile=%h/capture-node/instances/%i.env
ExecStart=%h/capture-node/.venv/bin/capture-node-web --config ${CAPTURE_NODE_CONFIG} --host 0.0.0.0 --port ${CAPTURE_NODE_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
