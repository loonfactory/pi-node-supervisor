{
  "schema_version": 1,
  "nodes": [
    {
      "id": "camera0",
      "kind": "capture-node",
      "activity_types": ["capture"],
      "profiles": ["default"],
      "boot_ready_seconds": 15,
      "prepare_seconds": 2,
      "default_runtime_seconds": 5,
      "cleanup_seconds": 10,
      "required": true,
      "endpoint": "http://127.0.0.1:8000",
      "request_timeout_seconds": 10,
      "completion_timeout_seconds": 60
    },
    {
      "id": "environment0",
      "kind": "sensor-node",
      "activity_types": ["sensor-collection"],
      "profiles": ["temperature-humidity"],
      "boot_ready_seconds": 10,
      "prepare_seconds": 1,
      "default_runtime_seconds": 10,
      "cleanup_seconds": 5,
      "required": true,
      "sensor_serial": {
        "driver": "cwt-soil-thc-s",
        "port": "/dev/ttyAMA0",
        "baudrate": 4800,
        "timeout_seconds": 1.0,
        "slave_id": 1
      }
    }
  ]
}
