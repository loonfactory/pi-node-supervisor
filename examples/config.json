  "sensors": {
    "defaults": {
      "schedule": "soilAllDay",
      "storages": [
        {
          "extends": "#/storages/local"
        },
        {
          "extends": "#/storages/nasFtps"
        }
      ]
    },
    "devices": {
      "soil": {
        "driver": {
          "name": "cwt_soil_thc_s",
          "port": "/dev/ttyAMA0",
          "baudRate": 4800,
          "unitId": 1
        }
      }
    }
  },
  "power": {
    "bootLeadSeconds": 45,
    "shutdownGraceSeconds": 30,
    "minOffSeconds": 300,
    "windows": [
      {
        "startTime": "08:50:00",
        "endTime": "09:30:00"
      },
      {
        "startTime": "17:30:00",
        "endTime": "18:10:00"
      }
    ]
  }
