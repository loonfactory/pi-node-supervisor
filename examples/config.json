                0.0
              ],
              "distortion_coefficients": {
                "k1": 0.018243449179951368,
                "k2": 0.3723067496336428,
                "p1": -0.0001782647331841917,
                "p2": -0.001798328039800326,
                "k3": -0.8894696665277914
              }
            }
          }
        }
      },
      "rgb": {
        "captureNode": {
          "camera": {
            "cameraNum": 1,
            "type": "picamera2",
            "params": {
              "horizontal_flip": true,
              "vertical_flip": true
            },
            "calibration": {
              "image_width": 3280,
              "image_height": 2464,
              "camera_matrix": [
                [
                  2558.3734365040254,
                  0.0,
                  1590.4157381064585
