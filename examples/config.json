{
  "schemaVersion": 2,
  "policies": {
    "clockToleranceSeconds": 10
  },
  "schedules": {
    "ndviDaytime": [
      {
        "type": "interval",
        "startTime": "05:00:00",
        "endTime": "20:00:00",
        "intervalSeconds": 1800
      }
    ],
    "soilAllDay": [
      {
        "type": "interval",
        "startTime": "00:00:00",
        "endTime": "23:59:59",
        "intervalSeconds": 1800
      }
    ]
  },
  "storages": {
    "local": {
      "type": "local",
      "basePath": "/data/capture"
    },
    "nasFtps": {
      "type": "ftps",
      "host": "192.168.12.2",
      "port": 21,
      "username": "captureftp",
      "passwordEnv": "CAPTURE_FTPS_PASSWORD",
      "basePath": "/capture",
      "tlsMode": "explicit",
      "verifyTls": false,
      "connectTimeoutSeconds": 10,
      "operationTimeoutSeconds": 120
    }
  },
  "cameras": {
    "defaults": {
      "captureNode": {
        "camera": {
          "previewFps": 10,
          "previewQuality": 75
        },
        "images": {
          "dng": {
            "embedMetadata": true
          }
        }
      },
      "schedule": "ndviDaytime",
      "storages": [
        {
          "extends": "#/storages/local"
        },
        {
          "extends": "#/storages/nasFtps"
        }
      ]
    },
    "devices": {
      "noir": {
        "captureNode": {
          "camera": {
            "cameraNum": 0,
            "type": "picamera2",
            "params": {
              "horizontal_flip": true,
              "vertical_flip": true
            }
          }
        }
      },
      "rgb": {
        "captureNode": {
          "camera": {
            "cameraNum": 1,
            "type": "picamera2",
            "params": {
              "horizontal_flip": true,
              "vertical_flip": true
            }
          }
        }
      }
    }
  },
  "sensors": {
    "defaults": {
      "schedule": "soilAllDay",
      "storages": [
        {
          "extends": "#/storages/local"
        },
        {
          "extends": "#/storages/nasFtps"
        }
      ]
    },
    "devices": {
      "soil": {
        "driver": {
          "name": "cwt_soil_thc_s",
          "port": "/dev/ttyAMA0",
          "baudRate": 4800,
          "unitId": 1
        }
      }
    }
  },
  "power": {
    "bootLeadSeconds": 45,
    "shutdownGraceSeconds": 30,
    "minOffSeconds": 300,
    "windows": [
      {
        "startTime": "08:50:00",
        "endTime": "09:30:00"
      },
      {
        "startTime": "17:30:00",
        "endTime": "18:10:00"
      }
    ]
  }
}